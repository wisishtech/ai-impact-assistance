{
  "properties": {
    "connectionReferences": {
      "shared_sharepointonline": {
        "runtimeSource": "embedded",
        "connection": {
          "connectionReferenceLogicalName": "iea_sharedsharepointonline_f130c"
        },
        "api": {
          "name": "shared_sharepointonline"
        }
      },
      "shared_approvals": {
        "runtimeSource": "embedded",
        "connection": {
          "connectionReferenceLogicalName": "iea_sharedapprovals_ea15e"
        },
        "api": {
          "name": "shared_approvals"
        }
      },
      "shared_teams": {
        "runtimeSource": "embedded",
        "connection": {
          "connectionReferenceLogicalName": "iea_sharedteams_9ecfc"
        },
        "api": {
          "name": "shared_teams"
        }
      }
    },
    "definition": {
      "$schema": "https://schema.management.azure.com/providers/Microsoft.Logic/schemas/2016-06-01/workflowdefinition.json#",
      "contentVersion": "1.0.0.0",
      "parameters": {
        "$authentication": {
          "defaultValue": {},
          "type": "SecureObject"
        },
        "$connections": {
          "defaultValue": {},
          "type": "Object"
        }
      },
      "triggers": {
        "When_an_item_is_created": {
          "recurrence": {
            "interval": 5,
            "frequency": "Minute"
          },
          "splitOn": "@triggerOutputs()?['body/value']",
          "metadata": {
            "operationMetadataId": "0f1baa02-a22f-4b86-8755-8303956dd771"
          },
          "type": "OpenApiConnection",
          "inputs": {
            "parameters": {
              "dataset": "https://wisishtech.sharepoint.com/sites/iea-knowledge",
              "table": "8ad7128e-660a-44eb-9c59-dc5a5848466a"
            },
            "host": {
              "apiId": "/providers/Microsoft.PowerApps/apis/shared_sharepointonline",
              "operationId": "GetOnNewItems",
              "connectionName": "shared_sharepointonline"
            }
          }
        }
      },
      "actions": {
        "Start_and_wait_for_an_approval": {
          "runAfter": {},
          "metadata": {
            "operationMetadataId": "a012a14c-e906-44ce-912d-8774d49237ff"
          },
          "type": "OpenApiConnectionWebhook",
          "inputs": {
            "parameters": {
              "approvalType": "Basic",
              "WebhookApprovalCreationInput/title": "Draft for review:  @{triggerOutputs()?['body/Program']}  @{triggerOutputs()?['body/IndicatorId']}",
              "WebhookApprovalCreationInput/assignedTo": "restricted.reviewer@WisishTech.onmicrosoft.com\n",
              "WebhookApprovalCreationInput/details": "@{triggerOutputs()?['body/Draft']}\n\nSources:\n@{triggerOutputs()?['body/Citations']}",
              "WebhookApprovalCreationInput/itemLink": "@triggerOutputs()?['body/{Link}']",
              "WebhookApprovalCreationInput/itemLinkDescription": "Open in Draft Reviews",
              "WebhookApprovalCreationInput/enableNotifications": true,
              "WebhookApprovalCreationInput/enableReassignment": true
            },
            "host": {
              "apiId": "/providers/Microsoft.PowerApps/apis/shared_approvals",
              "operationId": "StartAndWaitForAnApproval",
              "connectionName": "shared_approvals"
            }
          }
        },
        "Condition": {
          "actions": {
            "Update_item": {
              "metadata": {
                "operationMetadataId": "62d65a09-cd32-497f-8284-002e2a935253"
              },
              "type": "OpenApiConnection",
              "inputs": {
                "parameters": {
                  "dataset": "https://wisishtech.sharepoint.com/sites/iea-knowledge",
                  "table": "8ad7128e-660a-44eb-9c59-dc5a5848466a",
                  "id": "@triggerOutputs()?['body/ID']",
                  "item/Title": "@triggerOutputs()?['body/Title']",
                  "item/Reviewer": "@concat(outputs('Start_and_wait_for_an_approval')?['body/responses']?[0]?['responder/displayName'], ' (', outputs('Start_and_wait_for_an_approval')?['body/responses']?[0]?['responder/email'], ')')",
                  "item/Status/Value": "Approved",
                  "item/DecisionDate": "@outputs('Start_and_wait_for_an_approval')?['body/completionDate']"
                },
                "host": {
                  "apiId": "/providers/Microsoft.PowerApps/apis/shared_sharepointonline",
                  "operationId": "PatchItem",
                  "connectionName": "shared_sharepointonline"
                }
              }
            },
            "Post_message_in_a_chat_or_channel": {
              "runAfter": {
                "Update_item": [
                  "Succeeded"
                ]
              },
              "metadata": {
                "operationMetadataId": "8f32761b-6adc-4d1d-a698-26e686abb9bf"
              },
              "type": "OpenApiConnection",
              "inputs": {
                "parameters": {
                  "poster": "Flow bot",
                  "location": "Chat with Flow bot",
                  "body/recipient": "@{triggerOutputs()?['body/SubmittedByEmail']};",
                  "body/messageBody": "<p class=\"editor-paragraph\">Your draft for @{triggerBody()?['Program']} @{triggerBody()?['IndicatorId']} was approved.</p><p class=\"editor-paragraph\">Reviewer: @{concat(outputs('Start_and_wait_for_an_approval')?['body/responses']?[0]?['responder/displayName'], ' (', outputs('Start_and_wait_for_an_approval')?['body/responses']?[0]?['responder/email'], ')')}</p><p class=\"editor-paragraph\">Comment: @{coalesce(first(outputs('Start_and_wait_for_an_approval')?['body/responses'])?['comments'], 'No comment')}</p><p class=\"editor-paragraph\">Decided: @{convertFromUtc(outputs('Start_and_wait_for_an_approval')?['body/completionDate'], 'Eastern Standard Time', 'dd MMM yyyy, h:mm tt')}  ET (Washington, DC)</p>"
                },
                "host": {
                  "apiId": "/providers/Microsoft.PowerApps/apis/shared_teams",
                  "operationId": "PostMessageToConversation",
                  "connectionName": "shared_teams"
                }
              }
            }
          },
          "runAfter": {
            "Start_and_wait_for_an_approval": [
              "Succeeded"
            ]
          },
          "else": {
            "actions": {
              "Update_item_2": {
                "metadata": {
                  "operationMetadataId": "e3ac97ae-ffbc-4dfc-a3a1-5cfce8b9f662"
                },
                "type": "OpenApiConnection",
                "inputs": {
                  "parameters": {
                    "dataset": "https://wisishtech.sharepoint.com/sites/iea-knowledge",
                    "table": "8ad7128e-660a-44eb-9c59-dc5a5848466a",
                    "id": "@triggerOutputs()?['body/ID']  ",
                    "item/Title": "@triggerOutputs()?['body/Title']",
                    "item/Reviewer": "@concat(outputs('Start_and_wait_for_an_approval')?['body/responses']?[0]?['responder/displayName'], ' (', outputs('Start_and_wait_for_an_approval')?['body/responses']?[0]?['responder/email'], ')')",
                    "item/Status/Value": "Changes requested",
                    "item/ReviewerComment": "@coalesce(first(outputs('Start_and_wait_for_an_approval')?['body/responses'])?['comments'], 'No comment')",
                    "item/DecisionDate": "@outputs('Start_and_wait_for_an_approval')?['body/completionDate']"
                  },
                  "host": {
                    "apiId": "/providers/Microsoft.PowerApps/apis/shared_sharepointonline",
                    "operationId": "PatchItem",
                    "connectionName": "shared_sharepointonline"
                  }
                }
              },
              "Post_message_in_a_chat_or_channel_2": {
                "runAfter": {
                  "Update_item_2": [
                    "Succeeded"
                  ]
                },
                "metadata": {
                  "operationMetadataId": "ec7f7125-9fd0-44c9-ac6b-3899266bd2d3"
                },
                "type": "OpenApiConnection",
                "inputs": {
                  "parameters": {
                    "poster": "Flow bot",
                    "location": "Chat with Flow bot",
                    "body/recipient": "@{triggerOutputs()?['body/SubmittedByEmail']};",
                    "body/messageBody": "<p class=\"editor-paragraph\">Your draft for @{triggerBody()?['Program']} @{triggerBody()?['IndicatorId']} needs changes.</p><p class=\"editor-paragraph\">Reviewer: @{concat(outputs('Start_and_wait_for_an_approval')?['body/responses']?[0]?['responder/displayName'], ' (', outputs('Start_and_wait_for_an_approval')?['body/responses']?[0]?['responder/email'], ')')}</p><br><p class=\"editor-paragraph\">Comment: @{coalesce(first(outputs('Start_and_wait_for_an_approval')?['body/responses'])?['comments'], 'No comment')}</p><br><p class=\"editor-paragraph\">Please update the draft with the assistant and submit it again.</p>"
                  },
                  "host": {
                    "apiId": "/providers/Microsoft.PowerApps/apis/shared_teams",
                    "operationId": "PostMessageToConversation",
                    "connectionName": "shared_teams"
                  }
                }
              }
            }
          },
          "expression": {
            "equals": [
              "@outputs('Start_and_wait_for_an_approval')?['body/outcome']",
              "Approve"
            ]
          },
          "metadata": {
            "operationMetadataId": "30be2a47-61e4-4b77-8142-9694581cd130"
          },
          "type": "If"
        }
      }
    },
    "templateName": null
  },
  "schemaVersion": "1.0.0.0"
}